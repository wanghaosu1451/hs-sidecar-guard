      "rm\\s+-rf\\s+\\.?/\\.pytest_cache"
    ],
    "keywords": [
      "rm -rf ./tmp",
      "rm __pycache__",
      "rm .pytest_cache"
    ],
    "violation_score": 0.05,
    "description": "清理缓存/临时文件，正常维护操作"
  },
  {
    "label": "pip_install_benign",
    "patterns": [
      "pip\\s+install\\s+[a-zA-Z0-9_\\-]+",
      "npm\\s+install"
    ],
    "keywords": [
      "pip install",
      "npm install",
      "装依赖"
    ],
    "violation_score": 0.05,
    "description": "官方渠道装依赖，合规"
  },
  {
    "label": "systemctl_restart_prod",
    "patterns": [
